# Local backend configuration. Replace development values before deployment.
APP_ENV=development
JWT_SECRET=local-only-change-before-deployment
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000
ML_SERVICE_URL=http://127.0.0.1:8001

# Production only: use a persistent PostgreSQL URL, never SQLite on an ephemeral host.
DATABASE_URL=

# Google OAuth Client ID (public value; must match VITE_GOOGLE_CLIENT_ID).
GOOGLE_CLIENT_ID=

# Optional email recovery configuration.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=

# Optional security notifications webhook.
SECURITY_ALERT_WEBHOOK_URL=
